# ========================
# FlowScore — Environment Variables
# ========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Kaggle API (for dataset download) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# --- Model Configuration ---
MODEL_PATH=model/artifacts/model.pkl
SCALER_PATH=model/artifacts/scaler.pkl
EXPLAINER_PATH=model/artifacts/explainer.pkl

# --- Frontend (set in production) ---
# FRONTEND_URL=https://flowscore.vercel.app
# API_URL=https://flowscore-api.onrender.com
